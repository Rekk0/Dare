# Dare 环境变量样例。复制成 .env.local 后填入你自己的 key。
# .env.local 已被 gitignore，永远不要把真 key 写进任何会提交的文件。

# ---------- AI 厂商 ----------
# 下面这几个变量名不是写死在代码里的，是 providers.yaml 里各 provider 的
# apiKeyEnv / baseUrlEnv 声明的。换厂商时改 providers.yaml，这里跟着改名字。
# openai-compatible 适配器吃任何 OpenAI Chat Completions 格式的端点，
# 商业平台、聚合网关、自己用 vLLM / Ollama 起的本地服务都一样配。
#
# 下面是仓库自带那份 providers.yaml 用到的变量，是可跑通的示例，不是推荐。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 示例配置里的 fallback。它的音频要另调 ASR，走 MediaPlanner 的 transcode 路径
ZHIPU_API_KEY=

# mock  = 用 MockProvider，不联网不烧钱。CI 和本地开发用这个
# live  = 真的调厂商 API
AI_PROFILE=mock

# ---------- 数据库 ----------
# 留空则用 PGlite 内存库（Postgres 编译成 WASM，进程内跑，无需 docker）
DATABASE_URL=

# ---------- 存储 ----------
# 证据文件落在工作目录下的 .storage，路径写死在 src/storage/local.ts 里，
# 没有环境变量。systemd 的 WorkingDirectory 要指对。

# 公网可达的绝对地址。证据 URL 是交给 AI 厂商去拉的，不设这个变量
# 签出来的是相对路径，厂商拉不到，证据评审会全部静默失败，
# 日志里只有一句 The provided URL does not appear to be valid。
# 本地开发不设没关系，那时候厂商本来就拉不到局域网地址。
PUBLIC_BASE_URL=

# 签名密钥。留空则每次进程启动随机生成,
# 单进程开发能用，但进程重启会让未过期的签名 URL 全部失效，
# 多实例部署下实例 A 签的 URL 在实例 B 验不过。生产必须设。
STORAGE_SIGNING_SECRET=

# 已结算活动的证据保留天数，超过后由 scheduler 自动清理。
RETENTION_DAYS=7
