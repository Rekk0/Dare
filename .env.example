# Dare 环境变量样例。复制成 .env.local 后填入你自己的 key。
# .env.local 已被 gitignore，永远不要把真 key 写进任何会提交的文件。

# ---------- AI 厂商 ----------
# 默认用阿里百炼的 Qwen3.5-Omni：三家国内平台里只有它一个模型同时吃
# 文本 / 图像 / 音频 / 视频，且只有 3.5 这一代支持单次请求传多种非文本模态。
DASHSCOPE_API_KEY=

# base_url 有两种格式，看你控制台给的是哪个：
#   经典     https://dashscope.aliyuncs.com/compatible-mode/v1
#   带工作区 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选的 fallback。智谱的音频要另调 ASR 模型，走 MediaPlanner 的 transcode 路径
ZHIPU_API_KEY=

# mock  = 用 MockProvider，不联网不烧钱。CI 和本地开发用这个
# live  = 真的调厂商 API
AI_PROFILE=mock

# ---------- 数据库 ----------
# 留空则用 PGlite 内存库（Postgres 编译成 WASM，进程内跑，无需 docker）
DATABASE_URL=

# ---------- 对象存储（M4 才需要）----------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 签名密钥。留空则每次进程启动随机生成 ——
# 单进程开发能用，但进程重启会让未过期的签名 URL 全部失效，
# 多实例部署下实例 A 签的 URL 在实例 B 验不过。生产必须设。
STORAGE_SIGNING_SECRET=
